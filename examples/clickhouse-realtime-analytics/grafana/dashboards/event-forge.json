{
  "uid": "ef-clickhouse-realtime",
  "title": "Event Forge - Real-time Analytics",
  "description": "Real-time e-commerce event analytics from Event Forge simulator",
  "tags": ["event-forge", "clickhouse", "ecommerce"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Events Per Minute",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT minute AS time, total_events AS value FROM metrics_per_minute WHERE $__timeFilter(minute) ORDER BY minute",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Event Type Distribution",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT event_type AS name, count() AS value FROM events_raw WHERE $__timeFilter(timestamp) GROUP BY event_type ORDER BY value DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "displayLabels": ["name", "percent", "value"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Events by Type Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 16, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT minute AS time, landing_events AS landing, search_events AS search, product_view_events AS product_view, add_to_cart_events AS add_to_cart, checkout_events AS checkout, purchase_events AS purchase FROM metrics_per_minute WHERE $__timeFilter(minute) ORDER BY minute",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "last"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Conversion Funnel",
      "type": "bargauge",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT 'landing' AS stage, sum(landing_events) AS count FROM metrics_per_minute WHERE $__timeFilter(minute) UNION ALL SELECT 'search' AS stage, sum(search_events) AS count FROM metrics_per_minute WHERE $__timeFilter(minute) UNION ALL SELECT 'product_view' AS stage, sum(product_view_events) AS count FROM metrics_per_minute WHERE $__timeFilter(minute) UNION ALL SELECT 'add_to_cart' AS stage, sum(add_to_cart_events) AS count FROM metrics_per_minute WHERE $__timeFilter(minute) UNION ALL SELECT 'checkout' AS stage, sum(checkout_events) AS count FROM metrics_per_minute WHERE $__timeFilter(minute) UNION ALL SELECT 'purchase' AS stage, sum(purchase_events) AS count FROM metrics_per_minute WHERE $__timeFilter(minute)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text"
      }
    },
    {
      "id": 5,
      "title": "Event Rate",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT count() / 60.0 AS rate FROM events_raw WHERE timestamp >= now() - INTERVAL 1 MINUTE",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 800 },
              { "color": "red", "value": 1500 }
            ]
          },
          "min": 0,
          "max": 2000,
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT count(DISTINCT session_id) AS sessions FROM events_raw WHERE timestamp >= now() - INTERVAL 5 MINUTE",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 7,
      "title": "Total Events",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT count() AS total FROM events_raw",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 8,
      "title": "Events Last Minute",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "rawSql": "SELECT count() AS events FROM events_raw WHERE timestamp >= now() - INTERVAL 1 MINUTE",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "event_type",
        "type": "query",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "query": "SELECT DISTINCT event_type FROM events_raw ORDER BY event_type",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 1
      }
    ]
  }
}
